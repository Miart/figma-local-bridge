{
  // The plugin is bundled by esbuild, which strips types WITHOUT checking them.
  // Nothing else looked at these files, so a typo like `fp.appearanceHash` on a
  // type that has no such field compiled fine, ran fine, and silently serialised
  // away as `undefined` — three of figma_inspect's five fingerprint fields were
  // dead for as long as nobody ran this config. Server code has tsconfig.json;
  // this is the other half, and `npm run typecheck` runs both.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // The plugin sandbox has no Node and no DOM: Figma's typings supply the
    // globals (console, setTimeout) and nothing else may leak in.
    "types": ["@figma/plugin-typings"]
  },
  "include": ["plugin/**/*.ts"]
}
