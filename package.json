{
  "name": "figma-local-bridge",
  "version": "0.33.0",
  "type": "module",
  "description": "Local-first MCP bridge for Figma Desktop: read and edit the open file from Claude, OpenCode, Cursor and any MCP client (including ChatGPT and Gemini clients with local MCP support), without Dev Mode. Optional read-only Figma REST access for files that are not open, with local image downloads.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miart/figma-local-bridge.git"
  },
  "homepage": "https://github.com/Miart/figma-local-bridge#readme",
  "bugs": {
    "url": "https://github.com/Miart/figma-local-bridge/issues"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design",
    "plugin",
    "figma-plugin",
    "figma-rest-api",
    "claude",
    "chatgpt",
    "gemini",
    "llm",
    "design-system",
    "design-tokens",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "figma-local-bridge": "server/dist/index.js"
  },
  "main": "server/dist/index.js",
  "files": [
    "server/dist",
    "plugin/code.js",
    "plugin/ui.html",
    "plugin/manifest.json",
    "skills",
    "README.md",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "build:plugin": "node plugin/build.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:plugin && npm run build:server",
    "prepack": "npm run build",
    "daemon": "node server/dist/daemon.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.plugin.json",
    "test": "npm run build:plugin && npm run build:server && node --test --test-concurrency=1 test/*.test.mjs && node --test --test-concurrency=1 test/*.e2e.mjs",
    "smoke": "node scripts/mcp-smoke.mjs",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
